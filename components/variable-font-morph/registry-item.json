{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "variable-font-morph",
  "type": "hyperframes:component",
  "title": "Variable Font Morph",
  "description": "Sweeps a variable font's weight and width axes across a line, one character at a time, so the type swells and slims in a wave.",
  "tags": [
    "text-effects",
    "variable-font",
    "weight",
    "width",
    "kinetic-type",
    "remotion-ui-port"
  ],
  "category": "typography",
  "duration": 5,
  "useWhen": [
    "Display type should breathe: weight and width swelling in a travelling wave.",
    "A kinetic title with a variable font where the letterforms themselves are the motion."
  ],
  "avoidWhen": [
    "The type must hold one fixed style.",
    "You want letters to move position: use wave-text."
  ],
  "author": "RemotionUI",
  "authorUrl": "https://remotionui.com",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/riaz37/remotion-ui",
    "path": "apps/web/registry/bases/default/primitives/variable-font-morph.tsx",
    "commit": "0aecaca2b61a167992e1205d10e4da16d8a71331"
  },
  "files": [
    {
      "path": "variable-font-morph.html",
      "target": "compositions/components/variable-font-morph.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "The text. A line break starts a new line.",
      "default": "Stretch and\nbreathe"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Text size in pixels.",
      "default": 130,
      "min": 24,
      "max": 260,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Text color.",
      "default": "#f4f4f5"
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "motion",
      "label": "Split by",
      "description": "What one animated unit is.",
      "default": "chars",
      "options": [
        {
          "value": "chars",
          "label": "Characters"
        },
        {
          "value": "words",
          "label": "Words"
        },
        {
          "value": "lines",
          "label": "Lines"
        }
      ]
    },
    {
      "id": "order",
      "type": "enum",
      "role": "motion",
      "label": "Order",
      "description": "Order the units arrive in.",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start to end"
        },
        {
          "value": "end",
          "label": "End to start"
        },
        {
          "value": "center",
          "label": "Centre outwards"
        },
        {
          "value": "edges",
          "label": "Edges inwards"
        },
        {
          "value": "random",
          "label": "Random"
        }
      ]
    },
    {
      "id": "stagger_frames",
      "type": "number",
      "role": "motion",
      "label": "Stagger",
      "description": "Frames (30 per second) between one unit and the next.",
      "default": 3,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "duration_frames",
      "type": "number",
      "role": "motion",
      "label": "Unit duration",
      "description": "Frames one unit takes to arrive.",
      "default": 24,
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "delay_frames",
      "type": "number",
      "role": "motion",
      "label": "Delay",
      "description": "Frames before the first unit starts.",
      "default": 6,
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "exit",
      "type": "boolean",
      "role": "motion",
      "label": "Exit",
      "description": "Play an exit at the end of the clip.",
      "default": false
    },
    {
      "id": "weight_from",
      "type": "number",
      "role": "style",
      "label": "Weight from",
      "description": "Weight axis at the start of the sweep (100 to 900).",
      "default": 200,
      "min": 100,
      "max": 900,
      "step": 10
    },
    {
      "id": "weight_to",
      "type": "number",
      "role": "style",
      "label": "Weight to",
      "description": "Weight axis at the end of the sweep.",
      "default": 900,
      "min": 100,
      "max": 900,
      "step": 10
    },
    {
      "id": "width_from",
      "type": "number",
      "role": "style",
      "label": "Width from",
      "description": "Width axis at the start of the sweep (50 to 150).",
      "default": 60,
      "min": 50,
      "max": 150,
      "step": 1,
      "unit": "%"
    },
    {
      "id": "width_to",
      "type": "number",
      "role": "style",
      "label": "Width to",
      "description": "Width axis at the end of the sweep.",
      "default": 125,
      "min": 50,
      "max": 150,
      "step": 1,
      "unit": "%"
    },
    {
      "id": "oscillate",
      "type": "boolean",
      "role": "motion",
      "label": "Oscillate",
      "description": "Keep the axes swinging after the entrance instead of settling on the heavy end.",
      "default": true
    },
    {
      "id": "period_frames",
      "type": "number",
      "role": "motion",
      "label": "Period",
      "description": "Frames (30 per second) for one full swing.",
      "default": 60,
      "min": 12,
      "max": 240,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "phase_step",
      "type": "number",
      "role": "motion",
      "label": "Phase step",
      "description": "Phase offset between neighbouring characters, in radians.",
      "default": 0.55,
      "min": 0,
      "max": 3,
      "step": 0.05
    },
    {
      "id": "reserve_space",
      "type": "boolean",
      "role": "style",
      "label": "Reserve space",
      "description": "Hold each character's widest width so the line does not reflow while it morphs.",
      "default": true
    }
  ]
}
