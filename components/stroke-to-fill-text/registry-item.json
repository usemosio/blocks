{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "stroke-to-fill-text",
  "type": "hyperframes:component",
  "title": "Stroke to Fill Text",
  "description": "Draws type as an outline, then floods each letter solid with a soft edge, in the direction you choose.",
  "tags": [
    "text-effects",
    "outline",
    "stroke",
    "fill",
    "letters",
    "remotion-ui-port"
  ],
  "category": "typography",
  "duration": 4,
  "useWhen": [
    "A bold word should first read as a blueprint outline, then solidify: an editorial, confident reveal.",
    "Large display type where the stroke shows clearly."
  ],
  "avoidWhen": [
    "The text is small: the outline will not read, use split-text-chars.",
    "You want a hand-drawn stroke: use handwriting-text."
  ],
  "author": "RemotionUI",
  "authorUrl": "https://remotionui.com",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/riaz37/remotion-ui",
    "path": "apps/web/registry/bases/default/primitives/stroke-to-fill-text.tsx",
    "commit": "0aecaca2b61a167992e1205d10e4da16d8a71331"
  },
  "files": [
    {
      "path": "stroke-to-fill-text.html",
      "target": "compositions/components/stroke-to-fill-text.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "The text. A line break starts a new line.",
      "default": "Fill it in."
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Text size in pixels.",
      "default": 120,
      "min": 24,
      "max": 260,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Text color.",
      "default": "#f4f4f5"
    },
    {
      "id": "font_weight",
      "type": "number",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the text.",
      "default": 800,
      "min": 100,
      "max": 900,
      "step": 100
    },
    {
      "id": "font",
      "type": "enum",
      "role": "style",
      "label": "Font",
      "description": "Typeface.",
      "default": "poppins",
      "options": [
        {
          "value": "geist",
          "label": "Geist"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "grotesk",
          "label": "Space Grotesk"
        }
      ]
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "motion",
      "label": "Split by",
      "description": "What one animated unit is.",
      "default": "chars",
      "options": [
        {
          "value": "chars",
          "label": "Characters"
        },
        {
          "value": "words",
          "label": "Words"
        },
        {
          "value": "lines",
          "label": "Lines"
        }
      ]
    },
    {
      "id": "order",
      "type": "enum",
      "role": "motion",
      "label": "Order",
      "description": "Order the units arrive in.",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start to end"
        },
        {
          "value": "end",
          "label": "End to start"
        },
        {
          "value": "center",
          "label": "Centre outwards"
        },
        {
          "value": "edges",
          "label": "Edges inwards"
        },
        {
          "value": "random",
          "label": "Random"
        }
      ]
    },
    {
      "id": "stagger_frames",
      "type": "number",
      "role": "motion",
      "label": "Stagger",
      "description": "Frames (30 per second) between one unit and the next.",
      "default": 3,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "duration_frames",
      "type": "number",
      "role": "motion",
      "label": "Unit duration",
      "description": "Frames one unit takes to arrive.",
      "default": 24,
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "delay_frames",
      "type": "number",
      "role": "motion",
      "label": "Delay",
      "description": "Frames before the first unit starts.",
      "default": 6,
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "exit",
      "type": "boolean",
      "role": "motion",
      "label": "Exit",
      "description": "Play an exit at the end of the clip.",
      "default": false
    },
    {
      "id": "stroke_color",
      "type": "color",
      "role": "style",
      "label": "Stroke color",
      "description": "Colour of the outline.",
      "default": "#f4f4f5"
    },
    {
      "id": "stroke_width",
      "type": "number",
      "role": "style",
      "label": "Stroke width",
      "description": "Outline thickness in pixels.",
      "default": 3,
      "min": 0.5,
      "max": 16,
      "step": 0.5,
      "unit": "px"
    },
    {
      "id": "direction",
      "type": "enum",
      "role": "motion",
      "label": "Fill direction",
      "description": "Which way the fill floods each letter.",
      "default": "up",
      "options": [
        {
          "value": "up",
          "label": "Up"
        },
        {
          "value": "down",
          "label": "Down"
        },
        {
          "value": "left",
          "label": "Right to left"
        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ]
    },
    {
      "id": "edge_softness",
      "type": "number",
      "role": "style",
      "label": "Edge softness",
      "description": "Softness of the fill edge as a share of one letter.",
      "default": 0.12,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "stroke_retain",
      "type": "number",
      "role": "style",
      "label": "Stroke kept",
      "description": "How much of the outline stays once a letter is full (0 to 1).",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "id": "outline_frames",
      "type": "number",
      "role": "motion",
      "label": "Outline fade-in",
      "description": "Frames the outline takes to appear.",
      "default": 16,
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "frames"
    }
  ]
}
