{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "animated-line-chart",
  "type": "hyperframes:component",
  "title": "Animated Line Chart",
  "description": "A line chart whose path draws on from left to right with a glowing leading dot.",
  "tags": [
    "chart",
    "line",
    "trend",
    "draw-on",
    "data",
    "remocn-port"
  ],
  "category": "data-viz",
  "duration": 3,
  "useWhen": [
    "Showing growth or trend over time: a revenue curve, a user climb, an error rate drop.",
    "You want a single continuous reveal motion rather than a per-bar stagger."
  ],
  "avoidWhen": [
    "The data is categorical rather than time-ordered: use a bar chart.",
    "You have only two or three points: use a number counter or a headline stat."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/animated-line-chart/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "animated-line-chart.html",
      "target": "compositions/components/animated-line-chart.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "data",
      "type": "string",
      "role": "content",
      "label": "Data",
      "description": "Comma-separated numbers, at least two.",
      "default": "12, 19, 8, 15, 22, 18, 28, 25, 32"
    },
    {
      "id": "stroke_color",
      "type": "color",
      "role": "style",
      "label": "Line colour",
      "description": "Colour of the line and dot.",
      "default": "#22c55e"
    },
    {
      "id": "stroke_width",
      "type": "number",
      "role": "style",
      "label": "Line width",
      "description": "Width of the line.",
      "default": 4,
      "min": 1,
      "max": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "grid_color",
      "type": "color",
      "role": "style",
      "label": "Grid colour",
      "description": "Colour of the grid and axes.",
      "default": "#27272a"
    },
    {
      "id": "show_dot",
      "type": "boolean",
      "role": "style",
      "label": "Leading dot",
      "description": "Show a dot at the drawing tip.",
      "default": true
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ]
}