{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "exploded-stack",
  "type": "hyperframes:component",
  "title": "Exploded Stack",
  "description": "Isometric layer plates sit as one stack, explode apart along the vertical axis with labels drawing in beside each layer, hold, then collapse back so the clip loops. Four layers with their own glyph motifs and an accent colour.",
  "tags": [
    "3d",
    "isometric",
    "diagram",
    "layers",
    "architecture",
    "webgl",
    "webgl",
    "hyperframes-port"
  ],
  "category": "motion-graphics",
  "duration": 5,
  "useWhen": [
    "An architecture or stack explainer: four labelled layers that separate, are called out one by one and collapse again.",
    "A loopable isometric diagram for a product or system overview."
  ],
  "avoidWhen": [
    "More than four layers: the block is built for four.",
    "A flat 2D diagram."
  ],
  "author": "HeyGen (Hyperframes)",
  "authorUrl": "https://github.com/heygen-com/hyperframes",
  "license": "Apache-2.0",
