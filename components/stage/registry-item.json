{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "stage",
  "type": "hyperframes:component",
  "title": "Stage",
  "description": "A long page on a perspective studio plane, with the camera travelling across it on keyframes. The plane holds a built-in placeholder page drawn in CSS; to use your own, replace the markup inside #st-page in the file (it is 1265 wide and 5000 tall, scaled to the plane).",
  "tags": [
    "camera",
    "3d",
    "perspective",
    "screenshot",
    "studio",
    "remocn-port"
  ],
  "category": "layout",
  "duration": 10,
  "useWhen": [
    "A product screen, website or image should read as a photographed object rather than a flat full-frame capture.",
    "The camera needs to travel across one continuous surface, including a page much taller than the frame."
  ],
  "avoidWhen": [
    "You only need a full-frame fill or rounded inset with no 3D presentation: use backdrop.",
    "You are moving between two scenes: use a transition. Elements inside the subject need independent depth: Stage treats the page as one flat plane."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/stage/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "stage.html",
      "target": "compositions/components/stage.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "preset",
      "type": "enum",
      "role": "motion",
      "label": "Camera path",
      "description": "Camera keyframes for the move across the page.",
      "default": "smooth-descent",
      "options": [
        {
          "value": "smooth-descent",
          "label": "Smooth descent"
        },
        {
          "value": "site-tour",
          "label": "Site tour"
        },
        {
          "value": "hero-push",
          "label": "Hero push"
        },
        {
          "value": "section-hop",
          "label": "Section hop"
        }
      ]
    },
    {
      "id": "shake",
      "type": "number",
      "role": "motion",
      "label": "Handheld shake",
      "description": "Amount of deterministic handheld motion.",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "id": "seed",
      "type": "string",
      "role": "motion",
      "label": "Shake seed",
      "description": "Seed for the handheld motion.",
      "default": "smooth-descent"
    },
    {
      "id": "backdrop",
      "type": "string",
      "role": "style",
      "label": "Backdrop",
      "description": "CSS background behind the plane.",
      "default": "linear-gradient(145deg, #17181d 0%, #09090b 72%)"
    },
    {
      "id": "rotate_x",
      "type": "number",
      "role": "style",
      "label": "Rotate X",
      "description": "Tilt of the plane around the horizontal axis.",
      "default": 14,
      "min": -180,
      "max": 180,
      "step": 1,
      "unit": "deg"
    },
    {
      "id": "rotate_y",
      "type": "number",
      "role": "style",
      "label": "Rotate Y",
      "description": "Turn of the plane around the vertical axis.",
      "default": -20,
      "min": -180,
      "max": 180,
      "step": 1,
      "unit": "deg"
    },
    {
      "id": "perspective",
      "type": "number",
      "role": "style",
      "label": "Perspective",
      "description": "Camera perspective distance.",
      "default": 900,
      "min": 50,
      "max": 5000,
      "step": 25,
      "unit": "px"
    },
    {
      "id": "scale",
      "type": "number",
      "role": "style",
      "label": "Scale",
      "description": "Plane scale.",
      "default": 0.86,
      "min": 0.1,
      "max": 3,
      "step": 0.01
    },
    {
      "id": "radius",
      "type": "number",
      "role": "style",
      "label": "Radius",
      "description": "Corner radius as a percentage of the frame width.",
      "default": 1.4,
      "min": 0,
      "max": 4,
      "step": 0.1,
      "unit": "%"
    },
    {
      "id": "reflection",
      "type": "number",
      "role": "style",
      "label": "Reflection",
      "description": "Strength of the floor reflection.",
      "default": 0.24,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "id": "shadow",
      "type": "number",
      "role": "style",
      "label": "Contact shadow",
      "description": "Strength of the contact shadow.",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "id": "light",
      "type": "number",
      "role": "style",
      "label": "Studio light",
      "description": "Strength of the studio light overlay.",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.05
    }
  ]
}