{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "cursor-gravity",
  "type": "hyperframes:component",
  "title": "Cursor Gravity",
  "description": "A rounded triangular cursor tugs a button out of the screen edge with pulsed elastic resistance.",
  "tags": [
    "cursor",
    "button",
    "call-to-action",
    "elastic",
    "playful",
    "remocn-port"
  ],
  "category": "effects",
  "duration": 6,
  "useWhen": [
    "An empty scene should reveal a call to action through a physical pulling gesture.",
    "A button needs to feel extracted from beyond the frame with tension, recoil and release."
  ],
  "avoidWhen": [
    "A cursor must accurately demonstrate an existing interface: use simulated-cursor.",
    "Two complete scenes need to swap: this reveals one element rather than replacing the frame."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/cursor-gravity/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "cursor-gravity.html",
      "target": "compositions/components/cursor-gravity.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {"id":"label","type":"string","role":"content","label":"Label","description":"Button text.","default":"Create something"},
    {"id":"tension","type":"number","role":"motion","label":"Tension","description":"Strength of the elastic neck and recoil, 0 to 1.5.","default":1,"min":0,"max":1.5,"step":0.05},
    {"id":"cursor_color","type":"color","role":"style","label":"Cursor","description":"Cursor and tether color.","default":"#fffaf0"},
    {"id":"color","type":"color","role":"style","label":"Button","description":"Button fill color.","default":"#fffaf0"},
    {"id":"text_color","type":"color","role":"style","label":"Text","description":"Button text color.","default":"#32153c"},
    {"id":"background_color","type":"color","role":"style","label":"Background","description":"Backdrop color.","default":"#a800b7"},
    {"id":"speed","type":"number","role":"motion","label":"Speed","description":"Playback speed multiplier.","default":1,"min":0.25,"max":3,"step":0.05,"unit":"x"}
  ]
}
