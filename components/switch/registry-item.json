{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "switch",
  "type": "hyperframes:component",
  "title": "Switch",
  "description": "A switch that a pointer flips: the track fills with the primary color while the thumb slides across.",
  "tags": [
    "switch",
    "settings",
    "toggle",
    "ui",
    "remocn-port"
  ],
  "category": "ui",
  "duration": 3.5,
  "useWhen": [
    "A settings screen needs a setting being turned on.",
    "Showing an immediate on/off preference."
  ],
  "avoidWhen": [
    "A choice that is submitted later with a form: use checkbox.",
    "Exactly one of several options: use radio."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn-ui/switch/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "switch.html",
      "target": "compositions/components/switch.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Text beside the control.",
      "default": "Enable notifications"
    },
    {
      "id": "size",
      "type": "enum",
      "role": "style",
      "label": "Size",
      "description": "Control size.",
      "default": "default",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ]
    },
    {
      "id": "primary",
      "type": "color",
      "role": "style",
      "label": "Primary color",
      "description": "Accent for the filled control (remocn's primary prop).",
      "default": "#171717"
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Light or dark (shadcn neutral tokens).",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the interaction. Above 1 it finishes early and holds the last state.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    },
    {
      "id": "transparent",
      "type": "boolean",
      "role": "style",
      "label": "Transparent background",
      "description": "Skip the theme background so the control sits on your own scene.",
      "default": false
    }
  ]
}
