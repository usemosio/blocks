{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "alert-dialog",
  "type": "hyperframes:component",
  "title": "Alert Dialog",
  "description": "A destructive confirmation: a pointer clicks Delete account, a dimmed alert dialog scales in and the Delete button is pressed.",
  "tags": [
    "alert-dialog",
    "modal",
    "confirm",
    "destructive",
    "ui",
    "remocn-port"
  ],
  "category": "ui",
  "duration": 4,
  "useWhen": [
    "A flow needs an irreversible-action confirmation.",
    "Showing the safety net before a delete."
  ],
  "avoidWhen": [
    "A normal form modal with a close button: use dialog.",
    "Content should slide in from an edge: use sheet or drawer."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn-ui/alert-dialog/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "alert-dialog.html",
      "target": "compositions/components/alert-dialog.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "role": "content",
      "label": "Title",
      "description": "Heading of the popup.",
      "default": "Delete account?"
    },
    {
      "id": "description",
      "type": "string",
      "role": "content",
      "label": "Description",
      "description": "Body text under the heading.",
      "default": "This action cannot be undone. This will permanently remove your data from our servers."
    },
    {
      "id": "action_label",
      "type": "string",
      "role": "content",
      "label": "Action label",
      "description": "Primary button text.",
      "default": "Delete"
    },
    {
      "id": "cancel_label",
      "type": "string",
      "role": "content",
      "label": "Cancel label",
      "description": "Secondary button text.",
      "default": "Cancel"
    },
    {
      "id": "trigger_label",
      "type": "string",
      "role": "content",
      "label": "Trigger label",
      "description": "Text of the button the pointer clicks to open it.",
      "default": "Delete account"
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Light or dark (shadcn neutral tokens).",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the interaction. Above 1 it finishes early and holds the last state.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    },
    {
      "id": "transparent",
      "type": "boolean",
      "role": "style",
      "label": "Transparent background",
      "description": "Skip the theme background so the control sits on your own scene.",
      "default": false
    }
  ]
}
