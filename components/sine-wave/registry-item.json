{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "sine-wave",
  "type": "hyperframes:component",
  "title": "Sine Wave",
  "description": "A glowing white sine wave travels across a black frame.",
  "tags": [
    "shader",
    "webgl",
    "background",
    "wave",
    "line",
    "glow",
    "hyperframes-port"
  ],
  "category": "shaders",
  "duration": 5,
  "useWhen": [
    "A single flowing line over black for a voice, signal, pulse or minimal tech moment.",
    "A clean glow backdrop in any color."
  ],
  "avoidWhen": [
    "You want many bars reacting like an equalizer: use waveform.",
    "You want a filled, colorful background: use shader-mesh-gradient."
  ],
  "author": "HeyGen (Hyperframes)",
  "authorUrl": "https://github.com/heygen-com/hyperframes",
  "license": "Apache-2.0",
  "source": {
    "repo": "heygen-com/hyperframes",
    "path": "registry/blocks/sine-wave/sine-wave.html",
    "commit": "bd6cff8157a1a0ed5075527e673cc4f321fe9123"
  },
  "files": [
    {
      "path": "sine-wave.html",
      "target": "compositions/components/sine-wave.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Wave color",
      "description": "Color of the glowing line.",
      "default": "#ffffff"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Frame color behind the wave.",
      "default": "#000000"
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "How fast it moves. 0 holds still.",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "id": "amplitude",
      "type": "number",
      "role": "style",
      "label": "Amplitude",
      "description": "Height of the wave, as a share of the shorter side of the frame.",
      "default": 0.12,
      "min": 0,
      "max": 0.4,
      "step": 0.005
    },
    {
      "id": "frequency",
      "type": "number",
      "role": "style",
      "label": "Frequency",
      "description": "How many wave crests fit across the shorter side of the frame.",
      "default": 1.2,
      "min": 0.2,
      "max": 6,
      "step": 0.05
    },
    {
      "id": "thickness",
      "type": "number",
      "role": "style",
      "label": "Thickness",
      "description": "Width of the glowing line.",
      "default": 1,
      "min": 0.3,
      "max": 3,
      "step": 0.01
    },
    {
      "id": "resolution",
      "type": "number",
      "role": "quality",
      "label": "Resolution",
      "description": "Share of the frame size the shader is drawn at, then scaled up. Lower renders faster; raise it if edges look soft.",
      "default": 0.75,
      "min": 0.25,
      "max": 1,
      "step": 0.05
    }
  ],
  "webgl": true
}
