{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dropdown-menu",
  "type": "hyperframes:component",
  "title": "Dropdown Menu",
  "description": "An action menu: a pointer clicks the trigger, the menu drops open, a row is hovered and pressed, then the menu closes.",
  "tags": [
    "dropdown-menu",
    "menu",
    "actions",
    "ui",
    "remocn-port"
  ],
  "category": "ui",
  "duration": 4.5,
  "useWhen": [
    "An app demo needs an account or actions menu opening and a command being chosen.",
    "Showing contextual commands under a trigger."
  ],
  "avoidWhen": [
    "The chosen value should stay shown with a check: use select.",
    "A glide-between-options list: use select-menu."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn-ui/dropdown-menu/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "dropdown-menu.html",
      "target": "compositions/components/dropdown-menu.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Trigger text.",
      "default": "Options"
    },
    {
      "id": "items",
      "type": "string",
      "role": "content",
      "label": "Items",
      "description": "Comma-separated option labels.",
      "default": "Profile, Billing, Settings, Log out"
    },
    {
      "id": "highlighted_index",
      "type": "number",
      "role": "motion",
      "label": "Row index",
      "description": "Which row the pointer picks (0 is the first).",
      "default": 1,
      "min": 0,
      "max": 7,
      "step": 1
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Light or dark (shadcn neutral tokens).",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the interaction. Above 1 it finishes early and holds the last state.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    },
    {
      "id": "transparent",
      "type": "boolean",
      "role": "style",
      "label": "Transparent background",
      "description": "Skip the theme background so the control sits on your own scene.",
      "default": false
    }
  ]
}
