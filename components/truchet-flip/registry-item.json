{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "truchet-flip",
  "type": "hyperframes:component",
  "title": "Truchet Flip",
  "description": "A grid of quarter-circle tiles flips in waves, then settles into a clean pattern: rings, a field or a silhouette.",
  "tags": [
    "pattern",
    "truchet",
    "tiles",
    "generative",
    "background",
    "remocn-port"
  ],
  "category": "backgrounds",
  "duration": 4,
  "useWhen": [
    "A calm, rule-based pattern background should animate in and settle into a deliberate graphic.",
    "A bold geometric title card, transition or intro needs a tile grid that flips into order."
  ],
  "avoidWhen": [
    "You need an organic, noisy texture rather than a crisp grid.",
    "The background must keep moving forever: the pattern settles and holds."
  ],
