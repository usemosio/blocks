      "default": "#f472b6"
    },
    {
      "id": "glow_size",
      "type": "number",
      "role": "style",
      "label": "Glow size",
      "description": "Reach of the glow in pixels.",
      "default": 26,
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "off_level",
      "type": "number",
      "role": "style",
      "label": "Off level",
      "description": "Brightness of an unlit tube between strikes (0 to 1).",
      "default": 0.14,
      "min": 0,
      "max": 0.6,
      "step": 0.01
    },
    {
      "id": "hum",
      "type": "number",
      "role": "motion",
      "label": "Hum",
      "description": "Depth of the slow brightness wobble once lit.",
      "default": 0.12,
      "min": 0,
      "max": 0.6,
      "step": 0.01
    },
    {
      "id": "buzz",
      "type": "number",
      "role": "motion",
      "label": "Buzz",
      "description": "Chance per beat that a lit tube stutters.",
