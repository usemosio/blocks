      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Text color.",
      "default": "#fdf2f8"
    },
    {
      "id": "font_weight",
      "type": "number",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the text.",
      "default": 700,
      "min": 100,
      "max": 900,
      "step": 100
    },
    {
      "id": "font",
      "type": "enum",
      "role": "style",
      "label": "Font",
      "description": "Typeface.",
      "default": "geist",
      "options": [
        {
          "value": "geist",
          "label": "Geist"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "grotesk",
          "label": "Space Grotesk"
        }
      ]
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "motion",
      "label": "Split by",
      "description": "What one animated unit is.",
      "default": "chars",
      "options": [
        {
          "value": "chars",
          "label": "Characters"
        },
        {
          "value": "words",
          "label": "Words"
        },
        {
          "value": "lines",
          "label": "Lines"
        }
      ]
    },
    {
      "id": "order",
      "type": "enum",
      "role": "motion",
      "label": "Order",
      "description": "Order the units arrive in.",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start to end"
        },
        {
          "value": "end",
          "label": "End to start"
        },
        {
          "value": "center",
          "label": "Centre outwards"
        },
        {
          "value": "edges",
          "label": "Edges inwards"
        },
        {
          "value": "random",
          "label": "Random"
        }
      ]
    },
    {
      "id": "stagger_frames",
      "type": "number",
      "role": "motion",
