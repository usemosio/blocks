{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "neon-flicker-text",
  "type": "hyperframes:component",
  "title": "Neon Flicker Text",
  "description": "Lights a word tube by tube like a neon sign, with a mains hum that never quite settles and a dying flicker on the way out.",
  "tags": [
    "text-effects",
    "neon",
    "glow",
    "flicker",
    "letters",
    "remotion-ui-port"
  ],
  "category": "typography",
  "duration": 5,
  "useWhen": [
    "A word or short phrase should read as a neon sign: nightlife, retro, arcade, a late-night offer.",
    "You want per-letter ignition with a living hum while it holds."
  ],
  "avoidWhen": [
    "The sign must be one connected glass tube drawn along a path: use neon-sign.",
    "The tone is calm or corporate."
  ],
  "author": "RemotionUI",
  "authorUrl": "https://remotionui.com",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/riaz37/remotion-ui",
