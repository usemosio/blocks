{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "number-wheel",
  "type": "hyperframes:component",
  "title": "Number Wheel",
  "description": "A mechanical odometer: each digit is a wheel that rolls to the next number as a count runs up.",
  "tags": [
    "text-effects",
    "number",
    "counter",
    "odometer",
    "remocn-port"
  ],
  "category": "typography",
  "duration": 3.7333,
  "checkAt": [
    0.3,
    1.0,
    2.0,
    3.2
  ],
  "useWhen": [
    "A big metric should count up like a mechanical odometer: users, revenue, downloads.",
    "A results slide where the number change is the hero."
  ],
  "avoidWhen": [
    "The number is small and decorative: a plain counter is enough.",
    "The value is not an integer: this wheel rolls whole digits."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/number-wheel/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "number-wheel.html",
      "target": "compositions/components/number-wheel.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "from",
      "type": "number",
      "role": "content",
      "label": "From",
      "description": "Starting number.",
      "default": 0,
      "min": 0,
      "max": 10000000,
      "step": 1
    },
    {
      "id": "to",
      "type": "number",
      "role": "content",
      "label": "To",
      "description": "Number the wheels count up to.",
      "default": 24813,
      "min": 0,
      "max": 10000000,
      "step": 1
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Maximum digit size in pixels. A wide number shrinks to fit the frame.",
      "default": 120,
      "min": 24,
      "max": 400,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Digit color.",
      "default": "#171717"
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ]
}
