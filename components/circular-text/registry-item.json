{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "circular-text",
  "type": "hyperframes:component",
  "title": "Circular Text",
  "description": "Characters sit evenly around a circle and the whole ring spins steadily, like a badge or a stamp.",
  "tags": [
    "text-effects",
    "badge",
    "spin",
    "circular",
    "animata-port"
  ],
  "category": "typography",
  "duration": 6,
  "useWhen": [
    "A short phrase or tagline should circle a point as a rotating badge, seal or loader.",
    "A steady, endless rotation is wanted behind or around a logo or number."
  ],
  "avoidWhen": [
    "The text must be read quickly or in one line: use a typing or reveal block.",
    "Text is long: the characters crowd together; shorten it or enlarge the radius."
  ],
  "author": "Animata",
  "authorUrl": "https://animata.design",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/codse/animata",
    "path": "animata/text/circular-text.tsx",
    "commit": "25c27e5a874c60a56dcc1609df3b2c4f5f8456f8"
  },
  "files": [
    {
      "path": "circular-text.html",
      "target": "compositions/components/circular-text.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Characters placed around the circle; end it with a separator so the loop reads well.",
      "default": "CIRCULAR•TEXT•COMPONENT•"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Size of each character in pixels.",
      "default": 40,
      "min": 12,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "radius",
      "type": "number",
      "role": "style",
      "label": "Radius",
      "description": "Distance from the centre to the characters, in pixels.",
      "default": 230,
      "min": 40,
      "max": 520,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "spin_duration",
      "type": "number",
      "role": "motion",
      "label": "Spin duration",
      "description": "Seconds for one full turn. Equal to the block duration for an exact loop.",
      "default": 6,
      "min": 1,
      "max": 120,
      "step": 0.5,
      "unit": "s"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Text color.",
      "default": "#171717"
    },
    {
      "id": "font_weight",
      "type": "enum",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the text.",
      "default": "500",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    }
  ]
}
