{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "checkbox",
  "type": "hyperframes:component",
  "title": "Checkbox",
  "description": "A checkbox that a pointer ticks and unticks: the box fills with the primary color and the check draws in.",
  "tags": [
    "checkbox",
    "form",
    "toggle",
    "ui",
    "remocn-port"
  ],
  "category": "ui",
  "duration": 3.5,
  "useWhen": [
    "A form demo needs a terms or consent box being ticked.",
    "Showing multi-select options in a settings screen."
  ],
  "avoidWhen": [
    "Exactly one option may be chosen: use radio.",
    "An on/off setting that applies immediately: use switch."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn-ui/checkbox/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "checkbox.html",
      "target": "compositions/components/checkbox.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Text beside the control.",
      "default": "Accept terms and conditions"
    },
    {
      "id": "size",
      "type": "enum",
      "role": "style",
      "label": "Size",
      "description": "Control size.",
      "default": "default",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ]
    },
    {
      "id": "primary",
      "type": "color",
      "role": "style",
      "label": "Primary color",
      "description": "Accent for the filled control (remocn's primary prop).",
      "default": "#171717"
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Light or dark (shadcn neutral tokens).",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the interaction. Above 1 it finishes early and holds the last state.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    },
    {
      "id": "transparent",
      "type": "boolean",
      "role": "style",
      "label": "Transparent background",
      "description": "Skip the theme background so the control sits on your own scene.",
      "default": false
    }
  ]
}
