{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "split-text-chars",
  "type": "hyperframes:component",
  "title": "Split Text Chars",
  "description": "Splits a string into characters, words or lines and staggers them in with a fade-up, fade, scale or blur.",
  "tags": [
    "text-effects",
    "reveal",
    "kinetic-type",
    "letters",
    "stagger",
    "remotion-ui-port"
  ],
  "category": "typography",
  "duration": 4,
  "useWhen": [
    "Any headline or phrase needs a staggered character, word or line entrance, with the order and the look chosen in variables.",
    "You want one plain, reliable text entrance to build on."
  ],
  "avoidWhen": [
    "You want a specific signature look such as a wave, a neon strike or a handwritten stroke: use wave-text, neon-flicker-text or handwriting-text.",
    "The words follow a voiceover: use a caption block."
  ],
  "author": "RemotionUI",
  "authorUrl": "https://remotionui.com",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/riaz37/remotion-ui",
    "path": "apps/web/registry/bases/default/primitives/split-text-chars.tsx",
    "commit": "0aecaca2b61a167992e1205d10e4da16d8a71331"
  },
  "files": [
    {
      "path": "split-text-chars.html",
      "target": "compositions/components/split-text-chars.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "The text. A line break starts a new line.",
      "default": "Make it move."
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Text size in pixels.",
      "default": 84,
      "min": 24,
      "max": 260,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Text color.",
      "default": "#f4f4f5"
    },
    {
      "id": "font_weight",
      "type": "number",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the text.",
      "default": 600,
      "min": 100,
      "max": 900,
      "step": 100
    },
    {
      "id": "font",
      "type": "enum",
      "role": "style",
      "label": "Font",
      "description": "Typeface.",
      "default": "geist",
      "options": [
        {
          "value": "geist",
          "label": "Geist"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "grotesk",
          "label": "Space Grotesk"
        }
      ]
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "motion",
      "label": "Split by",
      "description": "What one animated unit is.",
      "default": "chars",
      "options": [
        {
          "value": "chars",
          "label": "Characters"
        },
        {
          "value": "words",
          "label": "Words"
        },
        {
          "value": "lines",
          "label": "Lines"
        }
      ]
    },
    {
      "id": "order",
      "type": "enum",
      "role": "motion",
      "label": "Order",
      "description": "Order the units arrive in.",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start to end"
        },
        {
          "value": "end",
          "label": "End to start"
        },
        {
          "value": "center",
          "label": "Centre outwards"
        },
        {
          "value": "edges",
          "label": "Edges inwards"
        },
        {
          "value": "random",
          "label": "Random"
        }
      ]
    },
    {
      "id": "stagger_frames",
      "type": "number",
      "role": "motion",
      "label": "Stagger",
      "description": "Frames (30 per second) between one unit and the next.",
      "default": 2,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "duration_frames",
      "type": "number",
      "role": "motion",
      "label": "Unit duration",
      "description": "Frames one unit takes to arrive.",
      "default": 20,
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "delay_frames",
      "type": "number",
      "role": "motion",
      "label": "Delay",
      "description": "Frames before the first unit starts.",
      "default": 6,
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "exit",
      "type": "boolean",
      "role": "motion",
      "label": "Exit",
      "description": "Play an exit at the end of the clip.",
      "default": false
    },
    {
      "id": "effect",
      "type": "enum",
      "role": "motion",
      "label": "Effect",
      "description": "How each unit arrives.",
      "default": "fade-up",
      "options": [
        {
          "value": "fade-up",
          "label": "Fade up"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "scale",
          "label": "Scale"
        },
        {
          "value": "blur",
          "label": "Blur"
        }
      ]
    },
    {
      "id": "travel",
      "type": "number",
      "role": "motion",
      "label": "Travel",
      "description": "How far a unit rises for the fade-up effect, in em.",
      "default": 0.42,
      "min": 0,
      "max": 2,
      "step": 0.02,
      "unit": "em"
    }
  ]
}
