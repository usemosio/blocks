{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "icon-shield",
  "type": "hyperframes:component",
  "title": "Shield Icon",
  "description": "An animated shield icon: the strokes draw in, then it plays its signature motion.",
  "tags": [
    "icon",
    "icons",
    "remocn-port",
    "shield"
  ],
  "category": "icons",
  "duration": 2,
  "useWhen": [
    "A video needs a shield glyph that draws itself on and then moves.",
    "A crisp line icon on a UI mockup, a feature list or a callout."
  ],
  "avoidWhen": [
    "A filled or photographic image is needed.",
    "The icon must stay perfectly still: use a static SVG."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "licenses": "Icon paths are derived from Lucide (https://lucide.dev), ISC License; see THIRD_PARTY.md.",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn-icons/icon-shield/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "icon-shield.html",
      "target": "compositions/components/icon-shield.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "animation",
      "type": "enum",
      "role": "motion",
      "label": "Animation",
      "description": "Draw the strokes, play the action, or both.",
      "default": "both",
      "options": [
        {
          "value": "draw",
          "label": "Draw"
        },
        {
          "value": "action",
          "label": "Action"
        },
        {
          "value": "both",
          "label": "Both"
        }
      ]
    },
    {
      "id": "loop",
      "type": "boolean",
      "role": "motion",
      "label": "Loop",
      "description": "Repeat the action motion.",
      "default": false
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05
    },
    {
      "id": "size",
      "type": "number",
      "role": "style",
      "label": "Size",
      "description": "Icon size in pixels.",
      "default": 48,
      "min": 8,
      "max": 1000,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Stroke color.",
      "default": "#171717"
    },
    {
      "id": "stroke_width",
      "type": "number",
      "role": "style",
      "label": "Stroke width",
      "description": "Stroke width in a 24-unit grid.",
      "default": 2,
      "min": 0.5,
      "max": 6,
      "step": 0.25
    }
  ]
}
