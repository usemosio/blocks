{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "caret",
  "type": "hyperframes:component",
  "title": "Caret",
  "description": "A blinking text caret: a thin rounded bar that flips on and off, sitting after a line of text.",
  "tags": [
    "caret",
    "blink",
    "text",
    "ui",
    "remocn-port"
  ],
  "category": "ui",
  "duration": 3,
  "useWhen": [
    "A text field or terminal line needs a blinking insertion point after typed or placeholder text.",
    "A UI mock-up needs the 'cursor is here' cue."
  ],
  "avoidWhen": [
    "You want text to type out: use caption-typewriter or the input block.",
    "A mouse pointer is needed: use cursor."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn-ui/caret/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "caret.html",
      "target": "compositions/components/caret.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Text the caret sits after.",
      "default": "Type something"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Size of the text in design pixels (scaled to fit the frame).",
      "default": 28,
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "height",
      "type": "number",
      "role": "style",
      "label": "Caret height",
      "description": "Bar height.",
      "default": 28,
      "min": 8,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "width",
      "type": "number",
      "role": "style",
      "label": "Caret width",
      "description": "Bar width.",
      "default": 3,
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "radius",
      "type": "number",
      "role": "style",
      "label": "Caret radius",
      "description": "Corner radius of the bar.",
      "default": 1,
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "blink",
      "type": "boolean",
      "role": "motion",
      "label": "Blink",
      "description": "Blink on and off. Off keeps the caret solid.",
      "default": true
    },
    {
      "id": "blink_per_second",
      "type": "number",
      "role": "motion",
      "label": "Blinks per second",
      "description": "Full on/off cycles per second.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.25,
      "unit": "Hz"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Caret color. Empty uses the theme foreground.",
      "default": ""
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Light or dark (shadcn neutral tokens).",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the interaction. Above 1 it finishes early and holds the last state.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    },
    {
      "id": "transparent",
      "type": "boolean",
      "role": "style",
      "label": "Transparent background",
      "description": "Skip the theme background so the control sits on your own scene.",
      "default": false
    }
  ]
}
