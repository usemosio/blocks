{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "typewriter",
  "type": "hyperframes:component",
  "title": "Typewriter",
  "description": "Text is typed out character by character at a steady rate, followed by a bar cursor that blinks once typing stops.",
  "tags": [
    "text-effects",
    "typing",
    "terminal",
    "cursor",
    "remocn-port"
  ],
  "category": "typography",
  "duration": 4,
  "useWhen": [
    "Simulating a command being typed into a terminal or input: pairs with terminal-simulator.",
    "A title should feel authored live rather than appearing all at once.",
    "You need the reveal duration to track the text length predictably (characters per second)."
  ],
  "avoidWhen": [
    "The text is long: typing a paragraph at a readable speed takes far longer than a viewer will wait; use staggered-fade-up.",
    "You want a designed, weighted entrance (springy, blurred, kinetic): use tracking-in or kinetic-center-build.",
    "Multiple lines should reveal together: typing is single-stream."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/typewriter/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "typewriter.html",
      "target": "compositions/components/typewriter.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Text that gets typed.",
      "default": "console.log('hello, world')"
    },
    {
      "id": "cursor",
      "type": "boolean",
      "role": "style",
      "label": "Cursor",
      "description": "Show the bar cursor after the text.",
      "default": true
    },
    {
      "id": "chars_per_second",
      "type": "number",
      "role": "motion",
      "label": "Characters per second",
      "description": "Typing rate.",
      "default": 22,
      "min": 4,
      "max": 60,
      "step": 1,
      "unit": "cps"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Maximum text size in pixels. Longer text shrinks to fit the frame.",
      "default": 72,
      "min": 12,
      "max": 220,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Text color.",
      "default": "#171717"
    },
    {
      "id": "cursor_color",
      "type": "color",
      "role": "style",
      "label": "Cursor color",
      "description": "Color of the cursor bar.",
      "default": "#171717"
    },
    {
      "id": "font_weight",
      "type": "enum",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the text.",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ]
}
