{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "flow-field",
  "type": "hyperframes:component",
  "title": "Flow Field",
  "description": "Hundreds of particles ride a seeded, slowly changing vector field and leave fine fading trails, as a seamless loop.",
  "tags": [
    "generative",
    "background",
    "loop",
    "lines",
    "particles",
    "remocn-port"
  ],
  "category": "motion-graphics",
  "duration": 10,
  "useWhen": [
    "A title card, quote or hero shot needs a quiet, organic line texture behind it that keeps moving without drawing attention.",
    "A scene about data, AI, networks or motion needs a generative backdrop that stays monochrome with a few accent strands.",
    "The background has to loop without a seam for any length of shot."
  ],
  "avoidWhen": [
    "The backdrop should be soft color fields rather than thin lines: use a gradient or mesh block.",
    "The motion should read as clouds or smoke rather than strands.",
    "The loop should be geometric and rule-based rather than organic."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/flow-field/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "flow-field.html",
      "target": "compositions/components/flow-field.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "particles",
      "type": "number",
      "role": "style",
      "label": "Particles",
      "description": "Number of particles in flight.",
      "default": 300,
      "min": 50,
      "max": 800,
      "step": 10
    },
    {
      "id": "trail_length",
      "type": "number",
      "role": "style",
      "label": "Trail length",
      "description": "Trail length in frames.",
      "default": 72,
      "min": 8,
      "max": 120,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "stroke_width",
      "type": "number",
      "role": "style",
      "label": "Stroke width",
      "description": "Trail width in pixels at 720p.",
      "default": 1.4,
      "min": 0.5,
      "max": 4,
      "step": 0.1,
      "unit": "px"
    },
    {
      "id": "accent_ratio",
      "type": "number",
      "role": "style",
      "label": "Accent share",
      "description": "Share of trails drawn in the accent color.",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "id": "loop_frames",
      "type": "number",
      "role": "motion",
      "label": "Loop frames",
      "description": "Frames for one seamless loop of the field. The component lasts 10 s, so 300 loops once.",
      "default": 300,
      "min": 120,
      "max": 600,
      "step": 30,
      "unit": "frames"
    },
    {
      "id": "seed",
      "type": "number",
      "role": "style",
      "label": "Seed",
      "description": "Changes the field and where the particles start.",
      "default": 1,
      "min": 1,
      "max": 50,
      "step": 1
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the simulation.",
      "default": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.1
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Background color.",
      "default": "#111111"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Trails",
      "description": "Trail color.",
      "default": "#FFFFFF"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "description": "Accent trail color.",
      "default": "#E5322D"
    }
  ]
}
