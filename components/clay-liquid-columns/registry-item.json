{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "clay-liquid-columns",
  "type": "hyperframes:component",
  "title": "Clay Liquid Columns",
  "description": "Five frosted-glass columns fill with coloured liquid that overshoots and settles with an elastic bounce, a percentage counting up above each, while a chunky clay-style info card with an icon pops in below every column.",
  "tags": [
    "data",
    "infographic",
    "progress",
    "columns",
    "glass",
    "liquid",
    "codepen-port"
  ],
  "category": "data-viz",
  "duration": 5,
  "useWhen": [
    "Five comparable percentages (progress, scores, shares) should fill up like liquid with a satisfying bounce.",
    "A dashboard-style recap with tidy labelled cards."
  ],
  "avoidWhen": [
    "You need more than five values or precise axes: use animated-bar-chart.",
    "A flat, minimal chart is wanted."
  ],
  "author": "dermalhealth",
  "authorUrl": "https://codepen.io/dermalhealth",
  "license": "MIT",
  "source": {
    "url": "https://codepen.io/dermalhealth/pen/rajQWyJ"
  },
