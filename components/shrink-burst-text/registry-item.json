{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "shrink-burst-text",
  "type": "hyperframes:component",
  "title": "Shrink Burst Text",
  "description": "A word squeezes tight and trembles, then bursts into letters that fly outward, spin and fade; the word slides back up into place and the cycle repeats.",
  "tags": [
    "text-effects",
    "explode",
    "burst",
    "letters",
    "loop",
    "impact",
    "animata-port"
  ],
  "category": "typography",
  "duration": 7.4,
  "useWhen": [
    "A word or message should be built up, shaken and blown apart as an impact beat.",
    "A looping 'send' or 'boom' moment on a short phrase."
  ],
  "avoidWhen": [
    "The text must stay readable throughout: it is fully gone for about a second each cycle.",
    "Long sentences."
  ],
  "author": "Animata",
  "authorUrl": "https://animata.design",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/codse/animata",
    "path": "animata/text/text-explode-imessage.tsx",
    "commit": "25c27e5a874c60a56dcc1609df3b2c4f5f8456f8"
  },
  "files": [
    {
      "path": "shrink-burst-text.html",
      "target": "compositions/components/shrink-burst-text.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Short phrase that bursts.",
      "default": "Hello there"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Maximum text size in pixels. Longer text shrinks to fit the frame.",
      "default": 110,
      "min": 12,
      "max": 300,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "spread",
      "type": "number",
      "role": "motion",
      "label": "Spread",
      "description": "Multiplier for how far the letters fly.",
      "default": 1,
      "min": 0.2,
      "max": 2,
      "step": 0.1
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Text color.",
      "default": "#171717"
    },
    {
      "id": "font_weight",
      "type": "enum",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the text.",
      "default": "700",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    }
  ],
  "checkAt": [
    0.5,
    1.3,
    2.3,
    3.2
  ]
}
