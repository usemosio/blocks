{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "nebula",
  "type": "hyperframes:component",
  "title": "Nebula Orb",
  "description": "A small world of pink and blue gas swirls inside a sphere on black.",
  "tags": [
    "shader",
    "webgl",
    "orb",
    "space",
    "nebula",
    "gas",
    "hyperframes-port"
  ],
  "category": "shaders",
  "duration": 5,
  "useWhen": [
    "A cosmic hero object for a space, AI or creative-tools moment.",
    "A colorful focal point on a dark frame."
  ],
  "avoidWhen": [
    "You want a full-frame sky: use aurora.",
    "The sphere should look hard and glossy: use plastic."
  ],
  "author": "HeyGen (Hyperframes)",
  "authorUrl": "https://github.com/heygen-com/hyperframes",
  "license": "Apache-2.0",
  "source": {
    "repo": "heygen-com/hyperframes",
    "path": "registry/blocks/nebula/nebula.html",
    "commit": "bd6cff8157a1a0ed5075527e673cc4f321fe9123"
  },
  "files": [
    {
      "path": "nebula.html",
      "target": "compositions/components/nebula.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "color_a",
      "type": "color",
      "role": "style",
      "label": "Gas color A",
      "description": "First gas color.",
      "default": "#14b8a6"
    },
    {
      "id": "color_b",
      "type": "color",
      "role": "style",
      "label": "Gas color B",
      "description": "Second gas color.",
      "default": "#1d4ed8"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Frame color behind the sphere.",
      "default": "#000000"
    },
    {
      "id": "size",
      "type": "number",
      "role": "style",
      "label": "Size",
      "description": "Diameter of the orb as a share of the shorter side of the frame.",
      "default": 0.62,
      "min": 0.2,
      "max": 1.2,
      "step": 0.01
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "How fast it moves. 0 holds still.",
      "default": 0.8,
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "id": "swirl",
      "type": "number",
      "role": "style",
      "label": "Swirl",
      "description": "How strongly the gas is stirred.",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.01
    },
    {
      "id": "resolution",
      "type": "number",
      "role": "quality",
      "label": "Resolution",
      "description": "Share of the frame size the shader is drawn at, then scaled up. Lower renders faster; raise it if edges look soft.",
      "default": 0.75,
      "min": 0.25,
      "max": 1,
      "step": 0.05
    }
  ],
  "webgl": true
}
