{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "caret-swap",
  "type": "hyperframes:component",
  "title": "Caret Swap",
  "description": "A gradient caret expands into a block that consumes the first text, then types the second.",
  "tags": [
    "text-effects",
    "typewriter",
    "caret",
    "swap",
    "remocn-port"
  ],
  "category": "typography",
  "duration": 2.2333,
  "checkAt": [
    0.4,
    0.75,
    1.0,
    2.1
  ],
  "useWhen": [
    "One phrase should be replaced by another through a caret gesture: the cursor swells into a block that eats the old text, collapses and types the new one.",
    "A typewriter beat mid-scene without clearing to an empty frame.",
    "A gradient caret should read as a character of its own, in an editor or AI-tool style."
  ],
  "avoidWhen": [
    "You only need one phrase typed from empty: use typewriter.",
    "The swap should happen word by word: use word-stream or value-swap.",
    "A full-frame transition driven by a caret: use caret-wipe."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
