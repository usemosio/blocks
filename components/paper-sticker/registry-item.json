{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "paper-sticker",
  "type": "hyperframes:component",
  "title": "Paper Sticker",
  "description": "Taped paper chips that slap onto a stop-motion scene over two poses, one after another.",
  "tags": [
    "paper",
    "stop-motion",
    "sticker",
    "label",
    "handmade",
    "remocn-port"
  ],
  "category": "effects",
  "duration": 4,
  "useWhen": [
    "Short labels, chips or callout notes should exist as physical taped paper on a stop-motion scene.",
    "A group of tags should land one after another."
  ],
  "avoidWhen": [
    "The content is long text or looks like interactive UI: this is a paper prop, not a component sim.",
    "You need a media frame with a caption underneath: use polaroid."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/paper-sticker/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "paper-sticker.html",
      "target": "compositions/components/paper-sticker.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "labels",
      "type": "string",
      "role": "content",
      "label": "Labels",
      "description": "Comma-separated labels, one sticker each.",
      "default": "fresh, local, handmade, new, hot"
    },
    {
      "id": "at",
      "type": "number",
      "role": "motion",
      "label": "Slap frame",
      "description": "Frame (30 fps) where the first sticker lands.",
      "default": 0,
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "stagger",
      "type": "number",
      "role": "motion",
      "label": "Stagger",
      "description": "Frames between one sticker and the next.",
      "default": 6,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "padding",
      "type": "string",
      "role": "style",
      "label": "Padding",
      "description": "CSS padding of each chip.",
      "default": "10px 16px"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Paper",
      "description": "Chip paper colour.",
      "default": "#fbfaf6"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Ink",
      "description": "Label colour.",
      "default": "#26242c"
    },
    {
      "id": "max_tilt",
      "type": "number",
      "role": "motion",
      "label": "Max tilt",
      "description": "Largest resting tilt per sticker.",
      "default": 2.6,
      "min": 0,
      "max": 8,
      "step": 0.2,
      "unit": "deg"
    },
    {
      "id": "seed",
      "type": "string",
      "role": "motion",
      "label": "Seed",
      "description": "Seed for tilt and jitter; each sticker gets its own.",
      "default": "sticker"
    },
    {
      "id": "step",
      "type": "number",
      "role": "motion",
      "label": "Frames per pose",
      "description": "How many frames each pose is held (30 fps).",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "frames"
    }
  ]
}