{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "infinite-marquee",
  "type": "hyperframes:component",
  "title": "Infinite Marquee",
  "description": "A continuously scrolling horizontal text strip that loops seamlessly.",
  "tags": [
    "text-effects",
    "marquee",
    "ticker",
    "loop",
    "ambient",
    "remocn-port"
  ],
  "category": "typography",
  "duration": 6,
  "useWhen": [
    "A scene needs ambient motion in the background or as a decorative band between sections.",
    "Looping brand words, feature names, or a tagline should scroll continuously without a start or end."
  ],
  "avoidWhen": [
    "The text should enter, hold, then exit: use blur-out-up or mask-reveal-up.",
    "You need 3D perspective depth on the strip: use perspective-marquee.",
    "The marquee should stop on a specific word: this one loops forever."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/infinite-marquee/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "infinite-marquee.html",
      "target": "compositions/components/infinite-marquee.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {"id": "text", "type": "string", "role": "content", "label": "Text", "description": "Text that repeats along the strip.", "default": "ship · build · animate · "},
    {"id": "font_size", "type": "number", "role": "style", "label": "Font size", "description": "Text size in pixels.", "default": 120, "min": 12, "max": 240, "step": 1, "unit": "px"},
    {"id": "color", "type": "color", "role": "style", "label": "Color", "description": "Text color.", "default": "#171717"},
    {"id": "font_weight", "type": "enum", "role": "style", "label": "Font weight", "description": "Weight of the text.", "default": "700", "options": [{"value": "400", "label": "Regular"}, {"value": "500", "label": "Medium"}, {"value": "600", "label": "Semibold"}, {"value": "700", "label": "Bold"}]},
    {"id": "pixels_per_frame", "type": "number", "role": "motion", "label": "Pixels per frame", "description": "Scroll speed at 30 fps.", "default": 4, "min": 1, "max": 30, "step": 1, "unit": "px"},
    {"id": "stroke", "type": "boolean", "role": "style", "label": "Stroke", "description": "Outline the letters instead of filling them.", "default": false},
    {"id": "stroke_color", "type": "color", "role": "style", "label": "Stroke color", "description": "Outline color when Stroke is on.", "default": "#171717"},
    {"id": "speed", "type": "number", "role": "motion", "label": "Speed", "description": "Playback speed multiplier.", "default": 1, "min": 0.25, "max": 4, "step": 0.05, "unit": "x"}
  ]
}
