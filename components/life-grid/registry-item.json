{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "life-grid",
  "type": "hyperframes:component",
  "title": "Life Grid",
  "description": "Conway's Game of Life runs on a seeded grid, newborn cells flashing in the accent and dying cells shrinking away.",
  "tags": [
    "generative",
    "background",
    "grid",
    "tech",
    "simulation",
    "remocn-port"
  ],
  "category": "motion-graphics",
  "duration": 10,
  "useWhen": [
    "A tech, AI or simulation story needs a background that visibly computes, with rule-based structures forming, colliding and dying.",
    "A pixel-grid look should stay alive behind a title for as long as the shot runs.",
    "A scene about emergence, growth or systems needs a literal, recognisable reference."
  ],
  "avoidWhen": [
    "The grid should be a pattern that resolves into a clean structure.",
    "The cells should rebuild a specific logo or image: use brick-mosaic.",
    "The motion should feel organic and continuous rather than stepped: use flow-field."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/life-grid/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "life-grid.html",
      "target": "compositions/components/life-grid.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "cols",
      "type": "number",
      "role": "style",
      "label": "Columns",
      "description": "Columns of cells; rows follow the frame aspect ratio.",
      "default": 48,
      "min": 12,
      "max": 96,
      "step": 2
    },
    {
      "id": "density",
      "type": "number",
      "role": "style",
      "label": "Density",
      "description": "Share of cells alive in the seeded first generation.",
      "default": 0.24,
      "min": 0.05,
      "max": 0.6,
      "step": 0.01
    },
    {
      "id": "frames_per_generation",
      "type": "number",
      "role": "motion",
      "label": "Frames per generation",
      "description": "Frames each generation is held.",
      "default": 5,
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "gap",
      "type": "number",
      "role": "style",
      "label": "Gap",
      "description": "Gap between tiles, as a fraction of the cell.",
      "default": 0.16,
      "min": 0,
      "max": 0.4,
      "step": 0.01
    },
    {
      "id": "show_grid",
      "type": "boolean",
      "role": "style",
      "label": "Lattice",
      "description": "Draw the faint lattice of empty cells.",
      "default": true
    },
    {
      "id": "seed",
      "type": "number",
      "role": "style",
      "label": "Seed",
      "description": "Changes the first generation.",
      "default": 7,
      "min": 1,
      "max": 50,
      "step": 1
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the simulation.",
      "default": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.1
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Background color.",
      "default": "#111111"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Cells",
      "description": "Living cell color.",
      "default": "#FFFFFF"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Newborns",
      "description": "Flash color for newborn cells.",
      "default": "#E5322D"
    }
  ]
}
