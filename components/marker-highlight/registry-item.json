{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "marker-highlight",
  "type": "hyperframes:component",
  "title": "Marker Highlight",
  "description": "A highlighter-pen bar springs across one word of a sentence, like a marker stroke.",
  "tags": [
    "text-effects",
    "highlight",
    "marker",
    "emphasis",
    "remocn-port"
  ],
  "category": "typography",
  "duration": 3,
  "checkAt": [
    0.3,
    0.6,
    0.9,
    2.5
  ],
  "useWhen": [
    "One word in a sentence should be marked like with a highlighter pen.",
    "A hand-made emphasis with a springy swipe, for key terms and benefits."
  ],
  "avoidWhen": [
    "The emphasis should be a quiet colour fade: use inline-highlight.",
    "Words should be marked in time with speech: use a caption highlight."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn/marker-highlight/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "marker-highlight.html",
      "target": "compositions/components/marker-highlight.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "before",
      "type": "string",
      "role": "content",
      "label": "Before",
      "description": "Text before the highlighted word.",
      "default": "Made for "
    },
    {
      "id": "highlight",
      "type": "string",
      "role": "content",
      "label": "Highlight",
      "description": "The word the marker covers.",
      "default": "builders"
    },
    {
      "id": "after",
      "type": "string",
      "role": "content",
      "label": "After",
      "description": "Text after the highlighted word.",
      "default": "."
    },
    {
      "id": "marker_color",
      "type": "color",
      "role": "style",
      "label": "Marker color",
      "description": "Color of the marker bar.",
      "default": "#facc15"
    },
    {
      "id": "base_color",
      "type": "color",
      "role": "style",
      "label": "Base color",
      "description": "Color of the sentence.",
      "default": "#171717"
    },
    {
      "id": "highlighted_text_color",
      "type": "color",
      "role": "style",
      "label": "Highlighted text color",
      "description": "Color the highlighted word fades to.",
      "default": "#171717"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Maximum text size in pixels. Longer text shrinks to fit the frame.",
      "default": 72,
      "min": 12,
      "max": 240,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "font_weight",
      "type": "enum",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the text.",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ]
}
