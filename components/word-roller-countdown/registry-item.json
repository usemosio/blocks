{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "word-roller-countdown",
  "type": "hyperframes:component",
  "title": "Word Roller Countdown",
  "description": "A countdown that scrolls through its numbers, then a blurred, accelerating spin that lands on a launch word with a springy settle.",
  "tags": [
    "text-effects",
    "typography",
    "countdown",
    "reveal",
    "launch",
    "remotion-scenes-port"
  ],
  "category": "typography",
  "duration": 4,
  "useWhen": [
    "A launch, reveal or sale start: 5 4 3 2 1 and then the big word.",
    "A tense, high-energy moment before a title."
  ],
  "avoidWhen": [
    "A calm title: the digits scroll and the screen pulses by design.",
    "A real clock or date: use event-countdown-clock."
  ],
  "author": "lifeprompt-team",
  "authorUrl": "https://github.com/lifeprompt-team/remotion-scenes",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/lifeprompt-team/remotion-scenes",
    "path": "src/scenes/RollerAnimations/RollerCountdown.tsx",
    "commit": "02c7a84241da7010b5f59c420b0110aafd1d6f0d"
  },
  "files": [
    {
      "path": "word-roller-countdown.html",
      "target": "compositions/components/word-roller-countdown.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "numbers",
      "type": "string",
      "role": "content",
      "label": "Countdown",
      "description": "The values counted through, separated by commas.",
      "default": "5, 4, 3, 2, 1"
    },
    {
      "id": "final_word",
      "type": "string",
      "role": "content",
      "label": "Final word",
      "description": "Word shown after the spin.",
      "default": "LAUNCH"
    },
    {
      "id": "subtitle",
      "type": "string",
      "role": "content",
      "label": "Subtitle",
      "description": "Small caps line under the final word.",
      "default": "YOUR JOURNEY BEGINS"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Size of the countdown digits in pixels. The launch word shrinks to fit the frame.",
      "default": 180,
      "min": 40,
      "max": 500,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Digit color",
      "description": "Color of the countdown digits.",
      "default": "#0a0a0a"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Launch color",
      "description": "Color of the final word.",
      "default": "#2563eb"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Fill behind the text. Use transparent to lay the block over your own footage.",
      "default": "#fafafa"
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ]
}
