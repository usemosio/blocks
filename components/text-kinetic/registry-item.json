{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-kinetic",
  "type": "hyperframes:component",
  "title": "Kinetic Bounce Type",
  "description": "Letters spring up from below one after another, scaling in from nothing, and then keep dancing: each bobs and tilts on its own slow sine while an accent underline draws beneath.",
  "tags": [
    "text-effects",
    "typography",
    "kinetic-type",
    "letters",
    "spring",
    "bounce",
    "remotion-scenes-port"
  ],
  "category": "typography",
  "duration": 3,
  "useWhen": [
    "A short, loud word or title (kinetic, hype, sale) that should keep a little life after it lands.",
    "Playful or energetic openers."
  ],
  "avoidWhen": [
    "The text should settle perfectly still: use per-character-rise.",
    "A long sentence: the letters keep moving and it gets hard to read."
  ],
  "author": "lifeprompt-team",
  "authorUrl": "https://github.com/lifeprompt-team/remotion-scenes",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/lifeprompt-team/remotion-scenes",
    "path": "src/scenes/TextAnimations/TextKinetic.tsx",
    "commit": "02c7a84241da7010b5f59c420b0110aafd1d6f0d"
  },
  "files": [
    {
      "path": "text-kinetic.html",
      "target": "compositions/components/text-kinetic.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Word or short phrase.",
      "default": "KINETIC"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Size of the text in pixels. Longer text shrinks to fit the frame.",
      "default": 120,
      "min": 20,
      "max": 400,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Text color",
      "description": "Color of the letters.",
      "default": "#0a0a0a"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Underline color",
      "description": "Color of the underline.",
      "default": "#2563eb"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Fill behind the text. Use transparent to lay the block over your own footage.",
      "default": "#fafafa"
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ]
}
