{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-split",
  "type": "hyperframes:component",
  "title": "Split Line Reveal",
  "description": "Two big left-aligned words arrive from opposite directions, one dropping in from above and one rising from below, while a rule draws across the gap and a thin vertical line grows at the right.",
  "tags": [
    "text-effects",
    "typography",
    "reveal",
    "two-line",
    "editorial",
    "remotion-scenes-port"
  ],
  "category": "typography",
  "duration": 3,
  "useWhen": [
    "A two-part title (word + word) that should open like a split, with a rule between.",
    "Editorial or poster-like headlines."
  ],
  "avoidWhen": [
    "A single word: use per-character-rise.",
    "Centered layouts: the block is left aligned."
  ],
  "author": "lifeprompt-team",
  "authorUrl": "https://github.com/lifeprompt-team/remotion-scenes",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/lifeprompt-team/remotion-scenes",
    "path": "src/scenes/TextAnimations/TextSplit.tsx",
    "commit": "02c7a84241da7010b5f59c420b0110aafd1d6f0d"
  },
  "files": [
    {
      "path": "text-split.html",
      "target": "compositions/components/text-split.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text_top",
      "type": "string",
      "role": "content",
      "label": "Top text",
      "description": "First line, drops in from above.",
      "default": "SPLIT"
    },
    {
      "id": "text_bottom",
      "type": "string",
      "role": "content",
      "label": "Bottom text",
      "description": "Second line, rises from below.",
      "default": "REVEAL"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Size of the text in pixels. Wide text shrinks to fit the frame.",
      "default": 140,
      "min": 30,
      "max": 400,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Text color",
      "description": "Color of both lines.",
      "default": "#0a0a0a"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Rule color",
      "description": "Color of the rule.",
      "default": "#2563eb"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Fill behind the text. Use transparent to lay the block over your own footage.",
      "default": "#fafafa"
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ]
}
