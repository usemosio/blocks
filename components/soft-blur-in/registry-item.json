{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "soft-blur-in",
  "type": "hyperframes:component",
  "title": "Soft Blur In",
  "description": "Per-character fade-in with a gentle blur and upward motion: an airy, soft premium reveal.",
  "tags": [
    "text-effects",
    "reveal",
    "blur",
    "letters",
    "premium",
    "remocn-port"
  ],
  "category": "typography",
  "duration": 2,
  "useWhen": [
    "A hero headline needs a premium, airy, cinematic per-character soft reveal.",
    "The text is long enough that a word-by-word stagger would take too long; per-character stagger with blur reads faster.",
    "The scene is clean and bright, so the blur-clear motion reads against the background."
  ],
  "avoidWhen": [
    "You want a hard exit animation: this is an entrance only.",
    "The vibe is tech, gritty or high-energy: use tracking-in or a glitch text for a sharper feel.",
    "You are swapping between two texts: use shared-axis-z or shared-axis-y."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
