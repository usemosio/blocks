{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-explode",
  "type": "hyperframes:component",
  "title": "Text Burst Explode",
  "description": "A heavy word grows in, then bursts: every letter flies outward at its own angle while spinning and fading, and a thin shockwave ring expands behind them.",
  "tags": [
    "text-effects",
    "typography",
    "explosion",
    "burst",
    "impact",
    "remotion-scenes-port"
  ],
  "category": "typography",
  "duration": 3,
  "useWhen": [
    "A word that should blow apart: a drop, a bang, an ending beat on a loud title.",
    "A transition out of a title where the letters scatter."
  ],
  "avoidWhen": [
    "The word must stay readable at the end: the letters fade as they fly.",
    "Quiet or elegant titles."
  ],
  "author": "lifeprompt-team",
  "authorUrl": "https://github.com/lifeprompt-team/remotion-scenes",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/lifeprompt-team/remotion-scenes",
    "path": "src/scenes/TextAnimations/TextExplode.tsx",
    "commit": "02c7a84241da7010b5f59c420b0110aafd1d6f0d"
  },
  "files": [
    {
      "path": "text-explode.html",
      "target": "compositions/components/text-explode.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Word to blow up. Short words (3 to 8 letters) work best.",
      "default": "BOOM"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Size of the letters in pixels. Wide text shrinks to fit the frame.",
      "default": 120,
      "min": 30,
      "max": 400,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Text color",
      "description": "Color of the letters.",
      "default": "#0a0a0a"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Ring color",
      "description": "Color of the shockwave ring.",
      "default": "#2563eb"
    },
    {
      "id": "background",
      "type": "color",
      "role": "style",
      "label": "Background",
      "description": "Fill behind the text. Use transparent to lay the block over your own footage.",
      "default": "#fafafa"
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    }
  ],
  "checkAt": [
    0.5,
    1.0,
    1.25,
    1.6
  ]
}
