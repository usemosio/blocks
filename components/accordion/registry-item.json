{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "accordion",
  "type": "hyperframes:component",
  "title": "Accordion",
  "description": "A collapsible panel: a pointer clicks the header, the chevron turns and the content unfolds, then it closes again.",
  "tags": [
    "accordion",
    "collapse",
    "faq",
    "ui",
    "remocn-port"
  ],
  "category": "ui",
  "duration": 4,
  "useWhen": [
    "A FAQ item or settings section needs to show it expanding on click.",
    "A product tour demonstrates progressive disclosure."
  ],
  "avoidWhen": [
    "You need an unfold effect as a scene transition: use accordion-unfold.",
    "A modal layer is needed instead of an inline panel: use dialog."
  ],
  "author": "Remocn",
  "authorUrl": "https://github.com/Remocn/remocn",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/Remocn/remocn",
    "path": "registry/remocn-ui/accordion/index.tsx",
    "commit": "126221ae00ba86eb40b65731b125ff398687d3b7"
  },
  "files": [
    {
      "path": "accordion.html",
      "target": "compositions/components/accordion.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "role": "content",
      "label": "Title",
      "description": "Header text.",
      "default": "Is it accessible?"
    },
    {
      "id": "content",
      "type": "string",
      "role": "content",
      "label": "Content",
      "description": "Text revealed in the panel.",
      "default": "Yes. It adheres to the WAI-ARIA design pattern."
    },
    {
      "id": "content_height",
      "type": "number",
      "role": "style",
      "label": "Content height",
      "description": "Height of the open panel in design pixels.",
      "default": 64,
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "variant",
      "type": "enum",
      "role": "style",
      "label": "Variant",
      "description": "Bordered card or borderless ghost.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Light or dark (shadcn neutral tokens).",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "id": "speed",
      "type": "number",
      "role": "motion",
      "label": "Speed",
      "description": "Playback speed of the interaction. Above 1 it finishes early and holds the last state.",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "step": 0.05,
      "unit": "x"
    },
    {
      "id": "transparent",
      "type": "boolean",
      "role": "style",
      "label": "Transparent background",
      "description": "Skip the theme background so the control sits on your own scene.",
      "default": false
    }
  ]
}
