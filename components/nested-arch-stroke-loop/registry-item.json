{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "nested-arch-stroke-loop",
  "type": "hyperframes:component",
  "title": "Nested Arch Stroke Loop",
  "description": "Five nested arch strokes each draw in as a short capsule, run to the end of the line and re-colour, every one on its own eased curve, so the colours ripple through the arches.",
  "tags": [
    "loop",
    "stroke",
    "drawsvg",
    "arches",
    "logo-sting",
    "background",
    "codepen-port"
  ],
  "category": "motion-graphics",
  "duration": 7.2,
  "useWhen": [
    "A looping rainbow-style stroke motif is needed as a background or a logo sting.",
    "A concentric line graphic should ripple with staggered colour changes."
  ],
  "avoidWhen": [
    "You need a still, quiet background.",
    "The graphic must stay inside a fixed safe area: the strokes slide out of the frame."
  ],
  "author": "creativeocean",
  "authorUrl": "https://codepen.io/creativeocean",
  "license": "MIT",
  "source": {
    "url": "https://codepen.io/creativeocean/pen/YPyjZmM"
  },
