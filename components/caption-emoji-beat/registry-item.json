{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "caption-emoji-beat",
  "type": "hyperframes:component",
  "title": "Caption Emoji Beat",
  "description": "Emoji stamps land on the beat over a caption line: each arrives with overshoot, wobbles once, holds, then releases.",
  "tags": [
    "captions",
    "emoji",
    "beat",
    "stamp",
    "social",
    "remotion-ui-port"
  ],
  "category": "captions",
  "duration": 5,
  "useWhen": [
    "A short caption or voiceover line needs emoji punctuation timed to a music beat or a cut.",
    "The beat times are known when the edit is cut: each emoji is scheduled on its own time."
  ],
  "avoidWhen": [
    "The emoji should follow spoken words from a transcript: use caption-emoji.",
    "The emoji must stay on screen with the caption for the whole phrase."
  ],
  "author": "RemotionUI",
  "authorUrl": "https://remotionui.com",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/riaz37/remotion-ui",
    "path": "apps/web/registry/bases/default/primitives/caption-emoji-beat.tsx",
    "commit": "0aecaca2b61a167992e1205d10e4da16d8a71331"
  },
  "files": [
    {
      "path": "caption-emoji-beat.html",
      "target": "compositions/components/caption-emoji-beat.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Caption",
      "description": "The caption line the emoji punctuate. Leave empty for emoji alone.",
      "default": "Make every beat count"
    },
    {
      "id": "beats",
      "type": "string",
      "role": "content",
      "label": "Beats",
      "description": "JSON list of emoji stamps: [{\"emoji\",\"at\",\"x\",\"y\",\"scale\",\"rotate\"}]. at is in seconds (or atInFrames in frames); x and y are percent of the frame from the top-left; scale is the size in px; rotate is the resting tilt in degrees.",
      "default": "[{\"emoji\": \"🔥\", \"at\": 0.6, \"x\": 22, \"y\": 30, \"rotate\": -10}, {\"emoji\": \"🎬\", \"at\": 1.3, \"x\": 78, \"y\": 26, \"rotate\": 8}, {\"emoji\": \"💡\", \"at\": 2.0, \"x\": 18, \"y\": 68, \"rotate\": -6}, {\"emoji\": \"⭐\", \"at\": 2.7, \"x\": 80, \"y\": 72, \"rotate\": 12}, {\"emoji\": \"👏\", \"at\": 3.4, \"x\": 50, \"y\": 20, \"scale\": 110}]"
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Caption size in pixels.",
      "default": 64,
      "min": 16,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "font_weight",
      "type": "number",
      "role": "style",
      "label": "Font weight",
      "description": "Weight of the caption.",
      "default": 800,
      "min": 100,
      "max": 900,
      "step": 100
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Color",
      "description": "Caption colour.",
      "default": "#fafafa"
    },
    {
      "id": "font",
      "type": "enum",
      "role": "style",
      "label": "Font",
      "description": "Typeface.",
      "default": "geist",
      "options": [
        {
          "value": "geist",
          "label": "Geist"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "grotesk",
          "label": "Space Grotesk"
        }
      ]
    },
    {
      "id": "emoji_size",
      "type": "number",
      "role": "style",
      "label": "Emoji size",
      "description": "Base emoji size in pixels.",
      "default": 84,
      "min": 24,
      "max": 300,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "land_frames",
      "type": "number",
      "role": "motion",
      "label": "Landing",
      "description": "Frames (30 per second) an emoji takes to land.",
      "default": 7,
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "hold_frames",
      "type": "number",
      "role": "motion",
      "label": "Hold",
      "description": "Frames it holds at full size before releasing.",
      "default": 26,
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "frames"
    },
    {
      "id": "overshoot",
      "type": "number",
      "role": "motion",
      "label": "Overshoot",
      "description": "Overshoot on the way in. 1 lands flat.",
      "default": 1.35,
      "min": 1,
      "max": 2,
      "step": 0.01
    },
    {
      "id": "wobble_degrees",
      "type": "number",
      "role": "motion",
      "label": "Wobble",
      "description": "Wobble after landing, in degrees.",
      "default": 9,
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "deg"
    },
    {
      "id": "text_at_frames",
      "type": "number",
      "role": "motion",
      "label": "Caption at",
      "description": "Frame the caption line arrives on.",
      "default": 0,
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "frames"
    }
  ],
  "checkAt": [
    0.8,
    1.5,
    2.3,
    3.2
  ]
}
